{
  "name": "buildandconnect",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@vinext/cloudflare": "^1.3.3",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "mapbox-gl": "^3.34.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "vinext": "^1.4.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.28",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261104.0-beta",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check": "npm run fmt:check && npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --dir migrations --local --persist-to .wrangler/state",
    "fmt:powershell": "pwsh -NoProfile -File scripts/format-powershell.ps1",
    "fmt:powershell:check": "pwsh -NoProfile -File scripts/format-powershell.ps1 -Check"
  }
}
