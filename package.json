{
  "name": "buildandconnect",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=26.13.0 <27",
    "bun": ">=1.4.2 <1.5.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@convex-dev/better-auth": "^0.13.0",
    "@elevenlabs/client": "^1.35.0",
    "@vinext/cloudflare": "^1.3.3",
    "better-auth": "~1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "mapbox-gl": "^3.34.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "vinext": "^1.4.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.28",
    "convex-test": "^0.0.67",
    "portless": "^0.16.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "type": "module",
  "scripts": {
    "ios:generate": "xcodegen generate --spec ios/project.yml",
    "ios:artwork": "bun scripts/ios-artwork.mjs",
    "ios:build": "node scripts/ios.mjs build",
    "ios:test": "node scripts/ios.mjs test",
    "ios:fmt": "node scripts/ios.mjs format",
    "ios:fmt:check": "node scripts/ios.mjs format-check",
    "ios:test:server": "node tests/native/server.mjs",
    "dev": "vite dev",
    "dev:remote": "node scripts/dev-remote.mjs",
    "dev:rex": "node scripts/dev-rex.mjs",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "typecheck": "cf workers types && tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "test": "node --test tests/*.test.ts && vitest run",
    "test:live": "CONVEX_LIVE_TESTS=1 node --env-file=.env.local --test tests/backend.live.test.ts",
    "dev:backend": "convex dev --tail-logs disable",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check": "bun run fmt:check && bun run typecheck && bun run test",
    "smoke": "node scripts/smoke.mjs",
    "setup:backend": "node scripts/configure-convex.mjs",
    "setup:voice": "node --env-file=.env.local scripts/setup-voice-agent.mjs",
    "fmt:powershell": "pwsh -NoProfile -File scripts/format-powershell.ps1",
    "fmt:powershell:check": "pwsh -NoProfile -File scripts/format-powershell.ps1 -Check"
  }
}
