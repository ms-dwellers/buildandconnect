# Public web configuration. These values will be visible in the browser.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Local Convex CLI selection, written by convex deployment select.
CONVEX_DEPLOYMENT=

# Server-only Worker configuration. Never prefix secrets with NEXT_PUBLIC_ or VITE_.
CONVEX_BRIDGE_SECRET=
SITE_URL=

# BETTER_AUTH_SECRET lives only in the Convex deployment's environment.
# Set to true explicitly to use remote Workers AI in local dev/preview (billable).
WORKERS_AI_REMOTE=

# Deployment tooling only; never expose to browser code.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
