# Public web configuration. These values will be visible in the browser.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Local Convex CLI selection, written by convex deployment select.
CONVEX_DEPLOYMENT=

# Web origin, also configured as SITE_URL in Convex for browser authentication.
SITE_URL=

# Configure these only in the Convex deployment, not in web/Worker settings:
# BETTER_AUTH_SECRET
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (social sign-in; a provider appears only when both are set)
# GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET
# OPENROUTER_API_KEY
# OPENROUTER_MODEL
# ELEVENLABS_API_KEY
# ELEVENLABS_STT_MODEL
# ELEVENLABS_AGENT_ID

# Deployment tooling only; never expose to browser code.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
