# Public web configuration. These values will be visible in the browser.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Runtime configuration. Use ignored .dev.vars locally and Worker secrets remotely.
# Do not prefix these with NEXT_PUBLIC_ or VITE_.
BETTER_AUTH_SECRET=
SITE_URL=

# Build/deployment configuration. Omit D1_DATABASE_ID for the isolated local DB.
D1_DATABASE_ID=
# Set to true explicitly to use remote Workers AI in local dev/preview (billable).
WORKERS_AI_REMOTE=

# Deployment tooling only; never expose to browser code.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
